# ========================================================
# MODELO DE CONFIGURAÇÃO DE AMBIENTE (.env.example)
# Copie este arquivo para um novo arquivo chamado .env:
# Exemplo: cp .env.example .env
# ========================================================

# Nome do Banco de Dados MySQL
DB_NAME=cifra_db

# Senha do usuário 'root' do MySQL
DB_ROOT_PASSWORD=sua_senha_segura_aqui

# Chave Secreta para Assinatura e Validação dos Tokens JWT
JWT_SECRET=sua_chave_secreta_jwt_longa_e_aleatoria_aqui
